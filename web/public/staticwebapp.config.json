{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/ByteSizedTraining/*",
      "/concepts/bytesized-lesson1/*",
      "/*.{svg,png,jpg,jpeg,gif,webp,ico,css,js,json,txt,xml,woff,woff2,ttf,otf,eot,map}",
      "/pmoflow/*"
    ]
  },
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/pmoflow",
      "redirect": "/pmoflow/",
      "statusCode": 301
    },
    {
      "route": "/pmoflow/pricing",
      "rewrite": "/pmoflow/pricing.html",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      }
    },
    {
      "route": "/pmoflow/security",
      "rewrite": "/pmoflow/security.html",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      }
    },
    {
      "route": "/pmoflow/demo",
      "rewrite": "/pmoflow/demo.html",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      }
    },
    {
      "route": "/pmoflow/compare",
      "rewrite": "/pmoflow/compare.html",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
      }
    },
    {
      "route": "/ByteSizedTraining",
      "redirect": "/ByteSizedTraining/",
      "statusCode": 301
    },
    {
      "route": "/concepts/bytesized-lesson1",
      "redirect": "/concepts/bytesized-lesson1/",
      "statusCode": 301
    },
    {
      "route": "/concepts/pmoflow",
      "redirect": "/concepts/pmoflow/",
      "statusCode": 301
    },
    {
      "route": "/concepts/pmoflow/app/*",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/concepts/pmoflow/*",
      "rewrite": "/concepts/pmoflow/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/api/bst/*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".yaml": "text/yaml",
    ".yml": "text/yaml"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
